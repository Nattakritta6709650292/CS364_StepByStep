<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_control_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Session Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activity Session"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Timer -->
    <TextView
        android:id="@+id/tv_session_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activity Duration"
        android:textSize="14sp"
        android:textColor="#757575"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Steps and Shakes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Steps -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Steps"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/tv_session_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#212121" />

        </LinearLayout>

        <!-- Shakes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shakes"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/tv_session_shakes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#212121" />

        </LinearLayout>

    </LinearLayout>

    <!-- Steps per Minute -->
    <TextView
        android:id="@+id/tv_steps_per_minute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Steps/min: 0"
        android:textSize="14sp"
        android:textColor="#424242"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Shakes per Minute -->
    <TextView
        android:id="@+id/tv_shakes_per_minute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shakes/min: 0"
        android:textSize="14sp"
        android:textColor="#424242"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Start and Stop Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/button_start_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start Activity"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/button_stop_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stop"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
