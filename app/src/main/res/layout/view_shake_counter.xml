<?xml version="1.0" encoding="utf-8"?>
<!-- TEMPORARY until Person 2 delivers view_shake_counter.xml. Keep the id tvShakeCount. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardShakeCounter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_tile_shakes"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvShakeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shake_counter_label"
            android:textColor="@color/shakes_color"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvShakeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/step_counter_zero"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="8" />

        <TextView
            android:id="@+id/tvShakeUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shake_counter_unit"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
